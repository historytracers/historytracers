#!/bin/sh

# SlackBuild for historytracers
# Builds a Slackware package from source

PRGNAM=historytracers
VERSION=${VERSION:-1.0.0}
BUILD=${BUILD:-1}
TAG=${TAG:-_SBo}

if [ -z "$ARCH" ]; then
  case "$(uname -m)" in
    x86_64) ARCH=x86_64 ;;
    i?86) ARCH=i586 ;;
    arm*) ARCH=arm ;;
    *) ARCH=$(uname -m) ;;
  esac
fi

CWD=$(pwd)
TMP=${TMP:-/tmp/SBo}
PKG=$TMP/package-$PRGNAM
OUTPUT=${OUTPUT:-/tmp}

NUMJOBS=${NUMJOBS:-"-j$(nproc 2>/dev/null || echo 1)"}

set -e

rm -rf $PKG
mkdir -p $TMP $PKG $OUTPUT

# Extract source tarball
cd $TMP
rm -rf $PRGNAM-$VERSION
tar xf $CWD/$PRGNAM-$VERSION.tar.xz
cd $PRGNAM-$VERSION

# Build using autotools
autoreconf -f -i

LOCALPATH=$(pwd)
LOGPATH="/var/log/historytracers"
CONF_PATH="/etc/historytracers/historytracers.conf"
SRC_PATH="/usr/share/historytracers"
CONTENT_PATH="/usr/share/historytracers/www"

./configure \
  --prefix=/usr \
  --disable-editor \
  --with-conf-path="$CONF_PATH" \
  --with-src-path="$SRC_PATH/" \
  --with-content-path="$CONTENT_PATH/" \
  --with-log-path="$LOGPATH/"

make $NUMJOBS all

# Create package directory structure
mkdir -p $PKG/usr/bin
mkdir -p $PKG/usr/share/$PRGNAM/www/images
mkdir -p $PKG/usr/doc/$PRGNAM
mkdir -p $PKG/etc/$PRGNAM
mkdir -p $PKG/var/log/$PRGNAM
mkdir -p $PKG/install

# Install binaries
install -m 755 build/historytracers $PKG/usr/bin/historytracers

# Install web content from www/
if [ -d "www/" ]; then
  cp -R www/* $PKG/usr/share/$PRGNAM/www/
fi

# Install editor.html alongside web content
if [ -f editor.html ]; then
  install -m 644 editor.html $PKG/usr/share/$PRGNAM/
fi

# Optionally install actual images from the images tarball
if [ -f $CWD/historytracers-images-${VERSION}.tar.gz ]; then
  tar xf $CWD/historytracers-images-${VERSION}.tar.gz -C $TMP
  mkdir -p $PKG/usr/share/$PRGNAM/www/images
  cp -R $TMP/historytracers-images/images/* $PKG/usr/share/$PRGNAM/www/images/
fi

# Install configuration file as .new (preserve user modifications on upgrade)
install -m 644 packaging/conf/historytracers.conf $PKG/etc/$PRGNAM/historytracers.conf.new

# Install documentation
if [ -f LICENSE ]; then
  install -m 644 LICENSE $PKG/usr/doc/$PRGNAM/
fi
if [ -f README.md ]; then
  install -m 644 README.md $PKG/usr/doc/$PRGNAM/
fi

# Install doinst.sh
cp packaging/Slackware/doinst.sh $PKG/install/doinst.sh
chmod 755 $PKG/install/doinst.sh

# Fix permissions
find $PKG -type d -exec chmod 755 {} \;
find $PKG -type f -exec chmod 644 {} \;
chmod 755 $PKG/usr/bin/historytracers
chmod 755 $PKG/install/doinst.sh

# Build the package
cd $PKG
/sbin/makepkg -l y -c n $OUTPUT/$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.txz

echo
echo "Package built: $OUTPUT/$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.txz"
echo
