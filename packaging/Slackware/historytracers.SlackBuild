#!/bin/sh

# SlackBuild for historytracers
# Builds a Slackware package from source

PRGNAM=historytracers
VERSION=${VERSION:-1.0.0}
BUILD=${BUILD:-1}
TAG=${TAG:-_SBo}

if [ -z "$ARCH" ]; then
  case "$(uname -m)" in
    x86_64) ARCH=x86_64 ;;
    i?86) ARCH=i586 ;;
    arm*) ARCH=arm ;;
    *) ARCH=$(uname -m) ;;
  esac
fi

CWD=$(pwd)
TMP=${TMP:-/tmp/SBo}
PKG=$TMP/package-$PRGNAM
PKG_WWW=$TMP/package-$PRGNAM-www
OUTPUT=${OUTPUT:-/tmp}

# Set source directory
SRCDIR=$CWD

# Check for source
if [ ! -d "$SRCDIR" ]; then
  echo "Source directory $SRCDIR not found"
  exit 1
fi

set -e
set -u

rm -rf "$PKG" "$PKG_WWW"
mkdir -p "$TMP" "$PKG" "$PKG_WWW" "$OUTPUT"

# Extract source tarball (its top directory is unversioned by convention)
cd "$TMP"
rm -rf "$PRGNAM"
tar xf "$CWD/$PRGNAM-$VERSION.tar.xz"
cd "$PRGNAM"

# Create main package directory structure (binary, config, docs, devel)
mkdir -p "$PKG/usr/bin"
mkdir -p "$PKG/usr/doc/$PRGNAM"
mkdir -p "$PKG/install"
cp packaging/Slackware/doinst.sh "$PKG/install/doinst.sh"
cat packaging/Slackware/historytracers-desc > "$PKG/install/slack-desc"
mkdir -p "$PKG/etc/$PRGNAM"
mkdir -p "$PKG/var/lib/$PRGNAM"
mkdir -p "$PKG/var/log/$PRGNAM"

# Create www package directory structure (standalone web content for any
# web server such as Apache; no binaries or service users required).
# No trailing www/ level: the tree lands directly in
# /var/www/htdocs/historytracers/.
mkdir -p "$PKG_WWW/var/www/htdocs/$PRGNAM"
mkdir -p "$PKG_WWW/var/www/htdocs/$PRGNAM/images"
mkdir -p "$PKG_WWW/install"
cp packaging/Slackware/doinst-www.sh "$PKG_WWW/install/doinst.sh"
cat packaging/Slackware/historytracers-www-desc > "$PKG_WWW/install/slack-desc"

# Build the project
chmod +x historytracers-installer.sh
./historytracers-installer.sh

# Generate the web content on the target: the source tarball ships no
# pre-built www/, so run the publisher the same way ht_compile() in
# historytracers2pkg.sh does. Needs the common/ submodule source (Go
# dependency of the publisher) and creates ./audios itself.
mkdir -p /var/log/historytracers 2>/dev/null || true
./build/historytracers-publisher -minify -audiofiles -gedcom -verbose -conf ./packaging/build_historytracers.conf >> historytracers.log 2>&1

# Install the binaries
install -m 755 build/historytracers "$PKG/usr/bin/historytracers"
#if [ -f build/historytracers-editor ]; then
#  install -m 755 build/historytracers-editor "$PKG/usr/bin/historytracers-editor"
#fi

# Install config as .new so doinst.sh can preserve admin changes
if [ -f packaging/conf/historytracers.conf ]; then
  install -m 600 packaging/conf/historytracers.conf "$PKG/etc/$PRGNAM/historytracers.conf.new"
fi

# Install web content into the www package (images handled separately)
if [ -d "www/" ]; then
  for item in www/*; do
    base=$(basename "$item")
    [ "$base" = "images" ] && continue
    cp -R "$item" "$PKG_WWW/var/www/htdocs/$PRGNAM/"
  done
fi

# Install image options config into the www package
if [ -f www/images/img_options.json ]; then
  install -m 644 www/images/img_options.json "$PKG_WWW/var/www/htdocs/$PRGNAM/images/"
fi

# Install editor.html alongside web content
if [ -f editor.html ]; then
  install -m 644 editor.html "$PKG_WWW/var/www/htdocs/$PRGNAM/"
fi

# Optionally install actual images from the images tarball into the www
# package, making it a self-contained site; use local images in that case
if [ -f "$CWD/historytracers-images-${VERSION}.tar.gz" ]; then
  tar xf "$CWD/historytracers-images-${VERSION}.tar.gz" -C "$TMP"
  mkdir -p "$PKG_WWW/var/www/htdocs/$PRGNAM/images"
  cp -R "$TMP/historytracers-images/images/." "$PKG_WWW/var/www/htdocs/$PRGNAM/images/"
  if [ -f "$PKG_WWW/var/www/htdocs/$PRGNAM/images/img_options.json" ]; then
    sed -i 's/"ht_local_images" : false/"ht_local_images" : true/' \
      "$PKG_WWW/var/www/htdocs/$PRGNAM/images/img_options.json"
  fi
fi

# Install documentation
if [ -f LICENSE ]; then
  install -m 644 LICENSE "$PKG/usr/doc/$PRGNAM/"
fi
if [ -f README.md ]; then
  install -m 644 README.md "$PKG/usr/doc/$PRGNAM/"
fi

# Install source code (devel): everything except generated www/, build
# outputs, VCS, autotools-generated files (bootstrap regenerates them) and
# publisher caches
mkdir -p "$PKG/usr/src/$PRGNAM"
for item in * .[!.]*; do
  [ -e "$item" ] || continue
  case "$(basename "$item")" in www|.git|build|artifacts|rpmbuild|err|out|historytracers.log|config.log|config.status|config.h|config.h.in|config.guess|config.sub|install-sh|missing|Makefile|Makefile.in|configure|aclocal.m4|autom4te.cache|build-aux|.ht_src_cache) continue;; esac
  case "$item" in *~) continue;; esac
  cp -R "$item" "$PKG/usr/src/$PRGNAM/"
done
# Strip dangling submodule metadata: common/.git is a gitlink file that
# means nothing outside the original clone
rm -f "$PKG/usr/src/$PRGNAM/common/.git"

chmod 755 "$PKG/install/doinst.sh"
chmod 755 "$PKG_WWW/install/doinst.sh"

# Fix permissions in both packages
for _pkg in "$PKG" "$PKG_WWW"; do
  find "$_pkg" -type d -exec chmod 755 {} \;
  # Ownership is handled by makepkg at package creation time
  find "$_pkg" -type f -perm 755 -exec chmod 755 {} \;
  find "$_pkg" -type f -perm 644 -exec chmod 644 {} \;
done

# Build both packages: the viewer and the standalone web content
cd "$PKG"
MAINPKG="$OUTPUT/$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.txz"
/sbin/makepkg -l y -c n "$MAINPKG"

cd "$PKG_WWW"
WWYPKG="$OUTPUT/$PRGNAM-www-$VERSION-noarch-$BUILD$TAG.txz"
/sbin/makepkg -l y -c n "$WWYPKG"

echo
echo "Packages built:"
echo "  $MAINPKG"
echo "  $WWYPKG"
echo
