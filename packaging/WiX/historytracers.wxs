<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="HistoryTracers" Version="$(var.MsiVersion)"
           Manufacturer="History Tracers Team"
           UpgradeCode="3A7F4D2E-1B5C-8F9A-0D3E-6C2B4A8F1E7D"
           Scope="perMachine">

    <Media Id="1" Cabinet="historytracers.cab" EmbedCab="yes" CompressionLevel="high" />

    <!-- Product icon: the very same icon.ico the viewer embeds and displays
         in the top-left corner of its window (src/viewer/icon.ico). It is
         used for the Start Menu/desktop shortcuts and for the Add/Remove
         Programs (Apps & Features) entry, so the installed product keeps
         the viewer's identity instead of the generic executable icon. -->
    <Icon Id="ViewerIcon" SourceFile="$(var.ProjectDir)\src\viewer\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="ViewerIcon" />

    <!-- License agreement shown by the wizard's License screen. The path
         is provided per language build from both build scripts
         (build_msi.ps1 and historytracers2pkg.sh):
           en-US -> packaging\WiX\gpl3.rtf
           es-ES -> packaging\WiX\gpl3.es-ES.rtf
           pt-BR -> packaging\WiX\gpl3.pt-BR.rtf
         All three share the official (English) GPL-3.0 text; only the
         preceding image-copyright notice is translated. -->
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />

    <!-- ============================================================ -->
    <!-- Install options (see contentroot.js for the custom action)    -->
    <!-- ============================================================ -->
    <!--
      INSTALLTYPE   - "Full" (default when unset): viewer binary + web
                      content installed under
                      ProgramFiles64Folder\HistoryTracers\www.
                      "ContentOnly": no binary, no Start Menu shortcuts; the
                      web content is installed flat into
                      <CONTENTROOT>\historytracers\.
      CONTENTROOT   - Target root folder of the content-only install. An
                      absolute path with or without a trailing backslash,
                      e.g. CONTENTROOT="D:\Sites". Required (and validated by
                      custom action CA.NormalizeContentRoot) when
                      INSTALLTYPE=ContentOnly; ignored otherwise.
      INSTALLIMAGES - "0" skips the museum image payload (default "1":
                      images are installed in both install types).
    -->
    <!-- Command-line only public properties (no Property table row needed):
         INSTALLTYPE  = Full()/ContentOnly, CONTENTROOT = target root folder,
         INSTALLIMAGES default. See comment above and contentroot.js. -->
    <Property Id="INSTALLIMAGES" Value="1" />

    <!-- Optional desktop shortcut. The user selects/clears the "Desktop
         Shortcut" feature with a checkbox on the wizard's Customize screen
         (WixUI_FeatureTree feature tree). Command-line equivalent: pass
         INSTALLLEVEL with ADDLOCAL=.../REMOVE=DesktopShortcut, e.g.
         msiexec /i HistoryTracers.msi REMOVE=DesktopShortcut. Installed by
         default; disabled in content-only installs (no viewer binary). -->

    <!-- Restores the content root remembered at install time when a
         content-only product is repaired/modified without properties. -->
    <Property Id="HTREMEMBEREDCONTENTROOT">
      <RegistrySearch Id="Ht_RememberedContentRoot" Root="HKLM"
                      Key="Software\HistoryTracers\Installer"
                      Name="ContentRoot" Type="raw" />
    </Property>

    <!-- Persists (both install types) the content root for later
         repair/uninstall resolution; empty in the Full mode. -->
    <Component Id="CONTENTROOT_reg" Directory="PROGRAMMENUDIR" Guid="*">
      <RegistryValue Root="HKLM" Key="Software\HistoryTracers\Installer"
                     Name="ContentRoot" Type="string"
                     Value="[CONTENTROOTCLEAN]" KeyPath="yes" />
    </Component>

    <Binary Id="NormalizeContentRootScript"
            SourceFile="$(var.ProjectDir)\packaging\WiX\contentroot.js" />
    <CustomAction Id="CA.NormalizeContentRoot"
                  BinaryRef="NormalizeContentRootScript"
                  JScriptCall="NormalizeContentRoot"
                  Execute="immediate"
                  Return="check" />

    <InstallExecuteSequence>
      <Custom Action="CA.NormalizeContentRoot" Before="CostFinalize"
              Condition="NOT REMOVED" />
    </InstallExecuteSequence>
    <InstallUISequence>
      <Custom Action="CA.NormalizeContentRoot" Before="CostFinalize"
              Condition="NOT REMOVED" />
    </InstallUISequence>

    <!-- ============================================================ -->
    <!-- Directory Structure                                          -->
    <!-- ============================================================ -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLDIR" Name="HistoryTracers">
        <Directory Id="WWWDIR" Name="www">
          <Directory Id="WWW_BODIES" Name="bodies" />
          <Directory Id="WWW_CSS" Name="css" />
          <Directory Id="WWW_CSV" Name="csv" />
          <Directory Id="WWW_GEDCOM" Name="gedcom" />
          <Directory Id="WWW_JS" Name="js" />
          <Directory Id="WWW_LANG" Name="lang" />
          <Directory Id="WWW_WEBFONTS" Name="webfonts" />
          <Directory Id="WWW_IMAGES" Name="images" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="PROGRAMMENUDIR" Name="HistoryTracers" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DESKTOPDIR_comp" Directory="DesktopFolder" Guid="*">
        <Shortcut Id="S_DesktopViewer" Name="HistoryTracers Viewer"
                  Description="!(loc.ShortcutViewerDescription)"
                  Icon="ViewerIcon"
                  Target="[INSTALLDIR]historytracers.exe"
                  WorkingDirectory="INSTALLDIR" />
        <RegistryValue Root="HKLM" Key="Software\HistoryTracers"
                       Name="desktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- ============================================================ -->
    <!-- Component: Start Menu Shortcuts                              -->
    <!-- ============================================================ -->
    <Component Id="PROGRAMMENUDIR_comp" Directory="PROGRAMMENUDIR" Guid="*">
      <Shortcut Id="S_Viewer" Name="HistoryTracers Viewer"
                Description="!(loc.ShortcutViewerDescription)"
                Icon="ViewerIcon"
                Target="[INSTALLDIR]historytracers.exe"
                WorkingDirectory="INSTALLDIR" />
      <!--Shortcut Id="S_Editor" Name="HistoryTracers Editor"
                Description="Launch HistoryTracers Editor"
                Target="[INSTALLDIR]historytracers-editor.exe"
                WorkingDirectory="INSTALLDIR" /-->
      <Shortcut Id="S_Uninstall" Name="Uninstall HistoryTracers"
                Description="!(loc.ShortcutUninstallDescription)"
                Target="[System64Folder]msiexec.exe"
                Arguments="/x [ProductCode]" />
      <RemoveFolder Id="PROGRAMMENUDIR_rem" On="uninstall" />
      <RegistryValue Root="HKLM" Key="Software\HistoryTracers"
                     Name="installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- ============================================================ -->
    <!-- Component: Install path registry entry                       -->
    <!-- ============================================================ -->
    <Component Id="INSTALLDIR_reg" Directory="INSTALLDIR" Guid="*">
      <CreateFolder />
      <RegistryValue Root="HKLM" Key="Software\HistoryTracers"
                     Name="InstallPath" Type="string" Value="[INSTALLDIR]" />
    </Component>

    <!-- ============================================================ -->
    <!-- Features                                                     -->
    <!-- ============================================================ -->
    <Feature Id="MainApplication" Title="!(loc.MainApplicationTitle)"
             Description="!(loc.MainApplicationDescription)"
             Level="1" Display="expand"
             ConfigurableDirectory="INSTALLDIR">
      <Level Condition='INSTALLTYPE="ContentOnly"' Value="0" />
      <ComponentRef Id="PROGRAMMENUDIR_comp" />
      <ComponentRef Id="INSTALLDIR_reg" />
      <ComponentGroupRef Id="CG_MAIN_BIN" />
    </Feature>

    <Feature Id="WebContent" Title="!(loc.WebContentTitle)"
             Description="!(loc.WebContentDescription)"
             Level="1">
      <ComponentGroupRef Id="CG_OPTIONS" />
      <ComponentGroupRef Id="CG_WWW" />
      <ComponentRef Id="CONTENTROOT_reg" />
    </Feature>

    <Feature Id="Images" Title="!(loc.ImagesTitle)"
             Description="!(loc.ImagesDescription)"
             Level="1">
      <Level Condition='INSTALLIMAGES="0"' Value="0" />
      <ComponentGroupRef Id="CG_IMAGES" />
    </Feature>

    <!-- Desktop shortcut: checkbox item in the wizard's Customize screen
         (WixUI_FeatureTree); installed by default, user can deselect it.
         Cleared (no shortcut) when INSTALLTYPE=ContentOnly because that
         mode installs no viewer binary to point at. -->
    <Feature Id="DesktopShortcut" Title="!(loc.DesktopShortcutTitle)"
             Description="!(loc.DesktopShortcutDescription)"
             Level="1" Display="collapse" AllowAdvertise="no">
      <Level Condition='INSTALLTYPE="ContentOnly"' Value="0" />
      <ComponentRef Id="DESKTOPDIR_comp" />
    </Feature>

    <!--Feature Id="Editor" Title="HistoryTracers Editor"
             Description="Content editor application (for content authors)"
             Level="3" TypicalDefault="install">
      <ComponentGroupRef Id="CG_EDITOR_BIN" />
    </Feature-->

    <Feature Id="Publisher" Title="!(loc.PublisherTitle)"
             Description="!(loc.PublisherDescription)"
             Level="3">
      <ComponentGroupRef Id="CG_PUBLISHER_BIN" />
    </Feature>

    <!-- ============================================================ -->
    <!-- UI Configuration (install wizard)                            -->
    <!-- ============================================================ -->
    <!-- Wizard screens: Welcome -> License -> Customize (feature       -->
    <!-- checkboxes, e.g. Image Files and Desktop Shortcut; Browse to    -->
    <!-- path; ConfigurableDirectory="INSTALLDIR" on MainApplication  -->
    <!-- enables the path picker) -> Verify -> Progress -> Done.      -->
    <!-- Linked against WixToolset.UI.wixext (see build_msi.ps1).     -->
    <!-- Command-line msiexec properties (INSTALLTYPE, CONTENTROOT,   -->
    <!-- INSTALLIMAGES, INSTALLDIR=...) still take precedence when    -->
    <!-- provided; e.g. INSTALLIMAGES=0 pre-unchecks Image Files.     -->
    <!-- Replaced the dead WiX v3 leftovers (ApplicationFolderName,   -->
    <!-- WixAppFolder) which silently produced a no-UI MSI.           -->
    <ui:WixUI Id="WixUI_FeatureTree" InstallDirectory="INSTALLDIR" />

    <!-- Major upgrade -->
    <MajorUpgrade DowngradeErrorMessage="!(loc.DowngradeErrorMessage)"
                  AllowSameVersionUpgrades="yes" />

  </Package>

</Wix>
