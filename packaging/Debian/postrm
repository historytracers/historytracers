#!/bin/sh
set -e

case "$1" in
    purge)
        # Remove config, state and logs on purge
        rm -rf /etc/historytracers /var/lib/historytracers /var/log/historytracers 2>/dev/null || true
        if getent passwd historytracers >/dev/null 2>&1; then
            deluser --system historytracers >/dev/null 2>&1 || true
        fi
        if getent group historytracers >/dev/null 2>&1; then
            delgroup --system historytracers >/dev/null 2>&1 || true
        fi
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload >/dev/null 2>&1 || true
            systemctl reset-failed historytracers.service >/dev/null 2>&1 || true
        fi
    ;;
    remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        # Reload systemd and reset failed state
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload >/dev/null 2>&1 || true
            systemctl reset-failed historytracers.service >/dev/null 2>&1 || true
        fi
    ;;
esac

#DEBHELPER#

exit 0
