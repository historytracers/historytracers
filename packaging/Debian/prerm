#!/bin/sh
set -e

case "$1" in
    remove)
        # Stop and disable service on package removal
        systemctl stop historytracers.service >/dev/null 2>&1 || true
        systemctl disable historytracers.service >/dev/null 2>&1 || true
    ;;
    upgrade)
        # Stop service before upgrade; do not disable
        systemctl stop historytracers.service >/dev/null 2>&1 || true
    ;;
esac

exit 0
