#!/usr/bin/make -f

%:
	dh $@

# DISABLE ALL auto steps
override_dh_auto_configure:
	@echo "Skipping configure"

override_dh_auto_build:
	@echo "Skipping build"

override_dh_auto_install:
	@echo "Skipping auto-install - using debhelper installation"

override_dh_auto_test:
	@echo "Skipping tests"

override_dh_auto_clean:
	@echo "Skipping auto-clean - preserving pre-built binaries"

override_dh_dwz:
	@echo "Skipping dwz compression for Go binary"

override_dh_install:
	# ===== MAIN PACKAGE (historytracers) =====

	# Binary, service, config
	install -D -m 755 $(CURDIR)/build/historytracers debian/historytracers/usr/bin/historytracers
	install -D -m 644 $(CURDIR)/packaging/service/historytracers.service debian/historytracers/lib/systemd/system/historytracers.service
	install -D -m 600 $(CURDIR)/packaging/conf/historytracers.conf debian/historytracers/etc/historytracers/historytracers.conf

	# ===== WEB CONTENT SUBPACKAGE (historytracers-www) =====
	# Standalone static content under /var/www/htdocs, usable with any
	# web server (Apache/IIS). No trailing www/ level: the tree lands
	# directly in /var/www/htdocs/historytracers/.

	# Web content: everything from www/ except images/
	install -d debian/historytracers-www/var/www/htdocs/historytracers
	for item in $(CURDIR)/www/*; do \
		base=$$(basename "$$item"); \
		[ "$$base" = "images" ] && continue; \
		cp -r "$$item" debian/historytracers-www/var/www/htdocs/historytracers/; \
	done
	# Only img_options.json from images/
	install -D -m 644 $(CURDIR)/www/images/img_options.json \
		debian/historytracers-www/var/www/htdocs/historytracers/images/img_options.json

	# ===== IMAGES SUBPACKAGE (historytracers-images) =====

	# Copy the full images/ tree except img_options.json, preserving hierarchy
	install -d debian/historytracers-images/var/www/htdocs/historytracers/images
	(cd $(CURDIR)/www/images && tar cf - --exclude=img_options.json .) | \
		(cd debian/historytracers-images/var/www/htdocs/historytracers/images && tar xf -)

	# ===== DEVEL SUBPACKAGE (historytracers-devel) =====

	# Copy everything from source root except build outputs, www/, VCS/packaging
	# temp dirs and local run artifacts (redirect captures like err/out and logs)
	dest=debian/historytracers-devel/usr/src/historytracers; \
	install -d "$$dest"; \
	for f in $(CURDIR)/* $(CURDIR)/.[!.]*; do \
		[ -e "$$f" ] || continue; \
		base=$$(basename "$$f"); \
		case "$$base" in www|.git|debian|build|artifacts|rpmbuild|err|out|historytracers.log|config.log|config.status|autom4te.cache) continue;; esac; \
		cp -r "$$f" "$$dest"/; \
	done
	# Drop stray Go build outputs left in the source tree (e.g. `go build`
	# without -o creates src/viewer/viewer). They are ELF binaries and must
	# not ship in the Architecture: all devel package.
	rm -f debian/historytracers-devel/usr/src/historytracers/src/viewer/viewer \
		debian/historytracers-devel/usr/src/historytracers/src/publisher/publisher \
		debian/historytracers-devel/usr/src/historytracers/src/editor/editor \
		debian/historytracers-devel/usr/src/historytracers/src/viewer/historytracers \
		debian/historytracers-devel/usr/src/historytracers/src/publisher/historytracers-publisher \
		debian/historytracers-devel/usr/src/historytracers/src/editor/historytracers-editor
	find debian/historytracers-devel/usr/src/historytracers/src -type f -exec sh -c 'file "$$1" 2>/dev/null | grep -q " ELF " && rm -f "$$1"' _ {} \;
