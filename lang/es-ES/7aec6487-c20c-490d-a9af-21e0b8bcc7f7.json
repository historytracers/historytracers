                        "day": ""
                     }
                  },
                  {
                     "type": 1,
                     "uuid": "75ca7e93-6ffd-4303-b21d-b669592dcde3",
                     "text": "Urton, G.",
                     "page": "",
                     "date_time": {
                        "type": "gregory",
                        "year": "2019",
