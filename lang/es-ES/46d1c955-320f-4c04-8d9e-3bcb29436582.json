                     }
                  }
               ],
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "html",
               "PostMention": ""
            },
            {
               "text": "<p class=\"desc\"><img id=\"imgUniverse\" onclick=\"htImageZoom('imgUniverse', '0%')\" class=\"imgcenter\" style=\"width: 80%;\"/><b>Figura 6</b>: Evolución del universo, según la Agencia Espacial Europea (ESA) (<htcite0>).</p>",
               "source": [
                  {
                     "type": 1,
                     "uuid": "a1a7c478-9061-4160-ba43-301c081733e9",
                     "text": "©ESA – C. Carreau",
