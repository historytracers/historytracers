               "family_id": "",
               "person_id": "",
               "id": "d1d3730c-3d29-425b-b4bb-26697cc1fede",
               "name": "Ejercitando la suma (números negativos)",
               "desc": "En este texto, el lector es presentado a una aplicación que genera sumas aleatorias de números negativos con descripciones de las etapas del cálculo.",
               "date_time": null
            },
