               "family_id": "",
               "person_id": "",
               "id": "05f0f747-c4e2-4c34-8cc4-be7ee1d37edd",
               "name": "Modulando (Parte II)",
               "desc": "En este texto, presentamos el concepto de una “tabla de multiplicar negativa” y cómo puede ayudarnos a entender el otro lado.",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "61ebf26a-c8ab-4bb4-bd1a-5bd2d5a5a28a",
               "name": "Modulando (Parte III)",
               "desc": "Continuando con el texto anterior, vemos cómo la “tabla de multiplicar negativa” nos permite profundizar en la comprensión de las inclinaciones.",
               "date_time": null
            }
