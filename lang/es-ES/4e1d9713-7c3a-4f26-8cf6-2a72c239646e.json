e-width=\"3\" style=\"stroke: black;\" marker-end=\"url(#arrow)\" /> <line x1=\"300\" y1=\"169\" x2=\"300\" y2=\"330\" stroke=\"black\" stroke-width=\"3\" style=\"stroke: black;\" marker-end=\"url(#arrow)\" /> <circle cx=\"300\" cy=\"170\" r=\"148\" transform=\"scale(-1 1) translate(-600 0)  rotate(180 300 170)\"></circle> <line class=\"radius-line\" x1=\"300\" y1=\"169\" x2=\"300\" y2=\"21\"></line> <line class=\"vertical45\" x1=\"405\" y1=\"64\" x2=\"300\" y2=\"-41\"></line> <line class=\"radius-45\" x1=\"300\" y1=\"169\" x2=\"405\" y2=\"64\"></line> <line class=\"vertical45\" x1=\"405\" y1=\"64\" x2=\"405\" y2=\"166\"></line> <line class=\"vertical45\" x1=\"300\" y1=\"169\" x2=\"448\" y2=\"21\"></line> <line class=\"vertical45\" x1=\"405\" y1=\"169\" x2=\"301\" y2=\"169\"></line> <text class=\"atlasTextRadius\" x=\"282\" y=\"95\" font-size=\"1.3em\" font-weight=\"bold\">1</text> <text class=\"atlasTextRadius\" x=\"208\" y=\"125\" font-size=\"1.3em\" font-weight=\"bold\">csc θ</text> <text class=\"atlasTextRadius\" x=\"365\" y=\"15\" font-size=\"1.3em\" font-weight=\"bold\">cot θ</text> <text class=\"atlasTextRadius\" x=\"345\" y=\"205\" font-size=\"1.3em\" font-weight=\"bold\">cos θ</text> <text class=\"atlasTextRadius\" x=\"419\" y=\"115\" font-size=\"1.3em\" font-weight=\"bold\" text-anchor=\"middle\" dominant-baseline=\"central\" transform=\"rotate(90, 419, 115)\">sen θ</text> <text class=\"atlasTextRadius\" x=\"320\" y=\"165\" font-size=\"1.0em\" font-weight=\"bold\">θ</text> <text class=\"atlasTextRadius\" x=\"282\" y=\"187\" font-size=\"1.3em\" font-weight=\"bold\">O</text> <text class=\"atlasTextRadius\" x=\"282\" y=\"-58\" font-size=\"1.3em\" font-weight=\"bold\">y</text> <text class=\"atlasTextRadius\" x=\"396\" y=\"52\" font-size=\"1.3em\" font-weight=\"bold\">P</text> <text class=\"atlasTextRadius\" x=\"520\" y=\"190\" font-size=\"1.3em\" font-weight=\"bold\">x</text></svg></div></p><p class=\"desc\"><b>Gráfico 1</b>: Círculo mostrando relaciones trigonométricas.</p>",
               "source": [],
