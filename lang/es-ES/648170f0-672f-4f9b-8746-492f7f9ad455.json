            },
            {
               "text": "<center><div class=\"first_steps_reflection_parent\"><div class=\"first_steps_reflection question_mark\"><i class=\"fa-solid fa-brain\"></i></div><div class=\"first_steps_reflection\"><b>Reflexión 2: Sobre el Cálculo 6</b><br /><br />¿Es correcto el resultado que muestra el Cálculo 6?</div></div></center>",
               "source": null,
