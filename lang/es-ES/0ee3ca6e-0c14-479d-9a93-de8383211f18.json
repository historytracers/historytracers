      {
         "id": "SECTION_cards",
         "text": [
            {
               "text": "<div class=\"htBoardSheet htBoardCardsSheet\"><div class=\"htBoardSheetTitle\">Cartas de suma para recortar</div><p class=\"htBoardSheetIntro\">Recorta las dos barajas siguiendo los bordes punteados. Mantén separadas la baraja A y la baraja B, y luego coloca cada baraja boca abajo.</p><div class=\"htBoardDeck\"><div class=\"htBoardDeckTitle\">Baraja A — primer número</div><div class=\"htBoardCardGrid\"><div class=\"htBoardCard\"><span class=\"htBoardCardLabel\">A</span><span class=\"htBoardCardNumber\">1</span></div><div class=\"htBoardCard\"><span class=\"htBoardCardLabel\">A</span><span class=\"htBoardCardNumber\">2</span></div><div class=\"htBoardCard\"><span class=\"htBoardCardLabel\">A</span><span class=\"htBoardCardNumber\">3</span></div><div class=\"htBoardCard\"><span class=\"htBoardCardLabel\">A</span><span class=\"htBoardCardNumber\">4</span></div><div class=\"htBoardCard\"><span class=\"htBoardCardLabel\">A</span><span class=\"htBoardCardNumber\">5</span></div><div class=\"htBoardCard\"><span class=\"htBoardCardLabel\">A</span><span class=\"htBoardCardNumber\">6</span></div><div class=\"htBoardCard\"><span class=\"htBoardCardLabel\">A</span><span class=\"htBoardCardNumber\">7</span></div><div class=\"htBoardCard\"><span class=\"htBoardCardLabel\">A</span><span class=\"htBoardCardNumber\">8</span></div><div class=\"htBoardCard\"><span class=\"htBoardCardLabel\">A</span><span class=\"htBoardCardNumber\">9</span></div><div class=\"htBoardCard\"><span class=\"htBoardCardLabel\">A</span><span class=\"htBoardCardNumber\">10</span></div></div></div><div class=\"htBoardDeck\"><div class=\"htBoardDeckTitle\">Baraja B — segundo número</div><div class=\"htBoardCardGrid\"><div class=\"htBoardCard\"><span class=\"htBoardCardLabel\">B</span><span class=\"htBoardCardNumber\">1</span></div><div class=\"htBoardCard\"><span class=\"htBoardCardLabel\">B</span><span class=\"htBoardCardNumber\">2</span></div><div class=\"htBoardCard\"><span class=\"htBoardCardLabel\">B</span><span class=\"htBoardCardNumber\">3</span></div><div class=\"htBoardCard\"><span class=\"htBoardCardLabel\">B</span><span class=\"htBoardCardNumber\">4</span></div><div class=\"htBoardCard\"><span class=\"htBoardCardLabel\">B</span><span class=\"htBoardCardNumber\">5</span></div><div class=\"htBoardCard\"><span class=\"htBoardCardLabel\">B</span><span class=\"htBoardCardNumber\">6</span></div><div class=\"htBoardCard\"><span class=\"htBoardCardLabel\">B</span><span class=\"htBoardCardNumber\">7</span></div><div class=\"htBoardCard\"><span class=\"htBoardCardLabel\">B</span><span class=\"htBoardCardNumber\">8</span></div><div class=\"htBoardCard\"><span class=\"htBoardCardLabel\">B</span><span class=\"htBoardCardNumber\">9</span></div><div class=\"htBoardCard\"><span class=\"htBoardCardLabel\">B</span><span class=\"htBoardCardNumber\">10</span></div></div></div><p class=\"htBoardSheetNote\">Recorta siguiendo las líneas punteadas y mantén las dos barajas separadas.</p></div>",
               "source": null,
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "html",
               "PostMention": ""
            }
