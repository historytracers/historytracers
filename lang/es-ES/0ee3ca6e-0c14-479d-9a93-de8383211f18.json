      {
         "id": "SECTION_marks",
         "text": [
            {
               "text": "<div class=\"htBoardSheet htBoardMarksSheet\"><div class=\"htBoardSheetTitle\">Veinte marcas rectangulares para recortar</div><p class=\"htBoardSheetIntro\">Recorta las veinte marcas rectangulares siguiendo los bordes punteados. Cada marca cabe en un rectángulo punteado del hueso.</p><div class=\"htBoardMarkGrid\" aria-label=\"Veinte marcas rectangulares para recortar\"><div class=\"htBoardMarkToken\" aria-hidden=\"true\"><span class=\"htBoardMarkGlyph\"></span></div><div class=\"htBoardMarkToken\" aria-hidden=\"true\"><span class=\"htBoardMarkGlyph\"></span></div><div class=\"htBoardMarkToken\" aria-hidden=\"true\"><span class=\"htBoardMarkGlyph\"></span></div><div class=\"htBoardMarkToken\" aria-hidden=\"true\"><span class=\"htBoardMarkGlyph\"></span></div><div class=\"htBoardMarkToken\" aria-hidden=\"true\"><span class=\"htBoardMarkGlyph\"></span></div><div class=\"htBoardMarkToken\" aria-hidden=\"true\"><span class=\"htBoardMarkGlyph\"></span></div><div class=\"htBoardMarkToken\" aria-hidden=\"true\"><span class=\"htBoardMarkGlyph\"></span></div><div class=\"htBoardMarkToken\" aria-hidden=\"true\"><span class=\"htBoardMarkGlyph\"></span></div><div class=\"htBoardMarkToken\" aria-hidden=\"true\"><span class=\"htBoardMarkGlyph\"></span></div><div class=\"htBoardMarkToken\" aria-hidden=\"true\"><span class=\"htBoardMarkGlyph\"></span></div><div class=\"htBoardMarkToken\" aria-hidden=\"true\"><span class=\"htBoardMarkGlyph\"></span></div><div class=\"htBoardMarkToken\" aria-hidden=\"true\"><span class=\"htBoardMarkGlyph\"></span></div><div class=\"htBoardMarkToken\" aria-hidden=\"true\"><span class=\"htBoardMarkGlyph\"></span></div><div class=\"htBoardMarkToken\" aria-hidden=\"true\"><span class=\"htBoardMarkGlyph\"></span></div><div class=\"htBoardMarkToken\" aria-hidden=\"true\"><span class=\"htBoardMarkGlyph\"></span></div><div class=\"htBoardMarkToken\" aria-hidden=\"true\"><span class=\"htBoardMarkGlyph\"></span></div><div class=\"htBoardMarkToken\" aria-hidden=\"true\"><span class=\"htBoardMarkGlyph\"></span></div><div class=\"htBoardMarkToken\" aria-hidden=\"true\"><span class=\"htBoardMarkGlyph\"></span></div><div class=\"htBoardMarkToken\" aria-hidden=\"true\"><span class=\"htBoardMarkGlyph\"></span></div><div class=\"htBoardMarkToken\" aria-hidden=\"true\"><span class=\"htBoardMarkGlyph\"></span></div></div><p class=\"htBoardSheetNote\">Recorta siguiendo las líneas punteadas.</p></div>",
               "source": null,
