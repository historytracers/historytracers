                        "year": "2024",
                        "month": "",
                        "day": ""
                     }
                  }
               ],
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "markdown",
               "PostMention": ""
            },
            {
               "text": "<center><div class=\"first_steps_reflection_parent\" style=\"background-color: #FFFFFF;\"><div class=\"first_steps_reflection\" style=\"background-color: #FFFFFF;\"><p>Vemos que el número de cuadrados de cada lado (9, 16 y 25) es simplemente la longitud de ese lado multiplicada por sí misma:</p><p><math mathsize=\"1.5em\" displaystyle=\"false\"><mn>9</mn><mo lspace=\"0.1667em\" rspace=\"0.1667em\">=</mo><mn>3</mn><mo lspace=\"0.1667em\" rspace=\"0.1667em\">x</mo><mn>3</mn></math><br /><math mathsize=\"1.5em\" displaystyle=\"false\"><mn>16</mn><mo lspace=\"0.1667em\" rspace=\"0.1667em\">=</mo><mn>4</mn><mo lspace=\"0.1667em\" rspace=\"0.1667em\">x</mo><mn>4</mn></math><br /><math mathsize=\"1.5em\" displaystyle=\"false\"><mn>25</mn><mo lspace=\"0.1667em\" rspace=\"0.1667em\">=</mo><mn>5</mn><mo lspace=\"0.1667em\" rspace=\"0.1667em\">x</mo><mn>5</mn></math></p><p class=\"desc\"><b>Cálculo 1</b>: Lados del triángulo expresados en cuadrados.</p></div></div></center>",
               "source": [],
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "html",
               "PostMention": ""
            },
            {
               "text": "<center><div class=\"first_steps_reflection_parent\"><div class=\"first_steps_reflection question_mark\"><i class=\"fa-solid fa-brain\"></i></div><div class=\"first_steps_reflection\"><b>Reflexión: Esto me recuerda...</b><br /><br />Observa el <b>Cálculo 1</b>.<br /><br />¿Puedes escribir una relación matemática que conecte los resultados del <b>Cálculo 1</b>?</div></div></center></p>",
               "source": [],
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "html",
               "PostMention": ""
            },
            {
               "text": "<center><div class=\"first_steps_reflection_parent\" style=\"background-color: #FFFFFF;\"><div class=\"first_steps_reflection\" style=\"background-color: #FFFFFF;\"><p>Al sumar los cuadrados de los dos catetos, obtenemos el cuadrado de la hipotenusa:</p><p><math mathsize=\"1.5em\" displaystyle=\"false\"><mn>9</mn><mo lspace=\"0.1667em\" rspace=\"0.1667em\">+</mo><mn>16</mn><mo lspace=\"0.1667em\" rspace=\"0.1667em\">=</mo><mn>25</mn></math></p><p class=\"desc\"><b>Cálculo 2</b>: Suma de los cuadrados de los catetos igual al cuadrado de la hipotenusa.</p><p>Este es el Teorema de Pitágoras. Lo escribimos con la <b>Fórmula 1</b>:</p><p><math mathsize=\"1.5em\" displaystyle=\"false\"><mrow><mrow><msup><mi>a</mi><mn>2</mn></msup><mo lspace=\"0.1667em\" rspace=\"0.1667em\">+</mo><msup><mi>b</mi><mn>2</mn></msup></mrow><mo lspace=\"0.1667em\" rspace=\"0.1667em\">=</mo><msup><mi>c</mi><mn>2</mn></msup></mrow></math></p><p class=\"desc\"><b>Fórmula 1</b>: Teorema de Pitágoras, donde <i>a</i> y <i>b</i> son los catetos y <i>c</i> es la hipotenusa.</p></div></div></center>",
               "source": [],
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "html",
               "PostMention": ""
            }
         ]
