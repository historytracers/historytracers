   "exercise_v2": [
      {
         "question": "¿Los números mesoamericanos y los etrusco-romanos tienen exactamente el mismo sistema de conteo?",
         "yesNoAnswer": "No",
         "additionalInfo": "Los números mesoamericanos tienen solo 3 símbolos, mientras que los etrusco-romanos desarrollaron 7 símbolos. Además, los números no se representan de la misma manera."
      },
      {
         "question": "¿Es posible escribir números de diferentes maneras?",
         "yesNoAnswer": "Yes",
         "additionalInfo": "Aunque existe una estandarización asociada al alfabeto, los números pueden escribirse de diferentes maneras, según la forma de escrita de cada persona o pueblo."
      }
   ],
