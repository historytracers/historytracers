            },
            {
               "text": "<p class=\"desc\"><img src=\"\" id=\"imgME\" onclick=\"htImageZoom('imgME', '0%')\" class=\"imgcenter\"/><b>Figura 1</b>: Mapa de la región del Medio Oriente. © Mapswire (<htcite0>).</p>",
               "source": [
                  {
