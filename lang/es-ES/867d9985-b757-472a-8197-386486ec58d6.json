                        "year": "2025",
                        "month": "",
                        "day": ""
                     }
                  },
                  {
                     "type": 1,
                     "uuid": "9c5cd96b-da2e-48b3-a88e-a6556c9973a7",
                     "text": "History Tracers Team",
                     "page": "Eu entendo isso como...",
                     "date_time": {
                        "type": "gregory",
                        "year": "2026",
                        "month": "",
                        "day": ""
                     }
