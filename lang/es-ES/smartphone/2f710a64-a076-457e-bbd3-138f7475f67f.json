         "source_menu": [],
         "text": [
            {
               "text": "Vamos a recordar lo que aprendimos.\n\nCon lo que hemos visto hasta ahora: ¿un punto cuenta como un objeto, y un rectángulo cuenta como cinco objetos?",
               "source": [],
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "markdown/html/text",
               "PostMention": ""
            }
         ],
         "desc": null,
         "next": "15a8f64e-4fac-4f31-906c-95554cccb36a",
         "prev": "",
         "jumpTo": "",
         "answer": "yes",
         "score": 1
      },
