         "smile": "thinking",
         "source_menu": [],
         "text": [
            {
                "text": "Vamos a reforzar nuestro conocimiento.\n\nCon lo que hemos visto hasta ahora, ¿eso quiere decir que los puntos equivalen a contar un solo objeto, y los rectángulos equivalen a cinco objetos?",
               "source": [],
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "markdown/html/text",
               "PostMention": ""
            }
         ],
         "desc": null,
         "next": "15a8f64e-4fac-4f31-906c-95554cccb36a",
         "prev": "",
         "jumpTo": "",
         "answer": "yes",
         "score": 1,
         "position": ""
      },
      {
