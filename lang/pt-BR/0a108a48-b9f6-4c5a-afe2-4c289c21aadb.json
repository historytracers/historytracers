                        "day": "21"
                     }
                  }
               ],
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "html",
               "PostMention": "."
            },
            {
               "text": "O *History Tracers* já tem um texto expositivo sobre o Grande Zimbábue (<htcite0>). Aqui, no atlas, vamos focar em uma pergunta: como os Shona negociaram com os chineses durante a **Fase 3** (<htdate0>/<htdate1> - <htdate2>/<htdate3>) do aparecimento de cerâmicas no leste da África, como descreve a doutora Bing Zhao (<htcite1>; <htcite2>).",
               "source": [
                  {
                     "type": 1,
                     "uuid": "0c717575-d51a-464d-9be6-8ecfda771376",
                     "text": "History Tracers Team",
                     "page": "Grande Zimbábue",
                     "date_time": {
                        "type": "gregory",
                        "year": "2025",
                        "month": "",
                        "day": ""
                     }
                  },
                  {
                     "type": 1,
                     "uuid": "f7381734-81dc-4bef-8527-44317f40c4b4",
                     "text": "Zhao, B.",
                     "page": "",
                     "date_time": {
                        "type": "gregory",
                        "year": "2015",
                        "month": "",
                        "day": ""
                     }
                  },
                  {
                     "type": 1,
                     "uuid": "0c717575-d51a-464d-9be6-8ecfda771376",
