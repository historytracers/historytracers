                        "day": "21"
                     }
                  },
                  {
                     "type": 1,
                     "uuid": "f023ffd4-7942-42d5-81e8-146da4491bef",
                     "text": "INAH - MX",
                     "page": "",
                     "date_time": {
                        "type": "gregory",
