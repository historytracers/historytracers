                     }
                  }
               ],
               "date_time": [
                  {
                     "type": "gregory",
                     "year": "2016",
                     "month": "10",
                     "day": "21"
                  }
               ],
               "isTable": false,
               "imgdesc": "Nesta imagem vemos, ao centro, a representação de uma divindade comumente associada ao Sol. Ao redor desta divindade observamos diferentes círculos e inscrições que serviam para marcar a passagem do tempo.",
               "format": "html",
               "PostMention": ""
            }
