                        "day": "-1"
                     }
                  }
               ],
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "markdown",
               "PostMention": ""
            },
            {
               "text": "<div class=\"htGreaterSmallerGame\"><span class=\"htGreaterSmallerLevel\" id=\"htGreaterSmallerLevel\"></span><span class=\"htGreaterSmallerQuestion\" id=\"htGreaterSmallerQuestion\">Os números estão em ordem? O número B é maior que o A?</span><div class=\"htGreaterSmallerCards\"><div class=\"htGreaterSmallerCard\"><span class=\"htGreaterSmallerLabel\">A</span><span class=\"htGreaterSmallerValue text_to_paint\" id=\"htGreaterSmallerLeft\">0</span></div><span class=\"htGreaterSmallerOp\" id=\"htGreaterSmallerOp\">&lt;</span><div class=\"htGreaterSmallerCard\"><span class=\"htGreaterSmallerLabel\">B</span><span class=\"htGreaterSmallerValue text_to_paint\" id=\"htGreaterSmallerRight\">1</span></div></div><div class=\"htGreaterSmallerButtonsRow\"><button type=\"button\" id=\"htGreaterSmallerInBtn\" class=\"htGreaterSmallerButton\">Em ordem</button><button type=\"button\" id=\"htGreaterSmallerNotBtn\" class=\"htGreaterSmallerButton\">Fora de ordem</button></div><div class=\"htGreaterSmallerFeedback\" id=\"htGreaterSmallerFeedback\" role=\"status\" aria-live=\"polite\"></div><div class=\"htGreaterSmallerNextContainer\"><button type=\"button\" id=\"htGreaterSmallerNewBtn\" class=\"reset-tutor-btn\">🎲 Novo exercício</button><button type=\"button\" id=\"htGreaterSmallerNextBtn\" class=\"reset-tutor-btn hidden\">Próximo nível</button></div><span id=\"htGreaterSmallerLevelTemplate\" class=\"htGreaterSmallerHidden\">Nível {n} de 4</span><span id=\"htGreaterSmallerMsgCorrect\" class=\"htGreaterSmallerHidden\">🎉 Parabéns! O número {big} é maior que {small} ({small} < {big}).</span><span id=\"htGreaterSmallerMsgCorrectMuch\" class=\"htGreaterSmallerHidden\">🎉 Parabéns! O número {big} é muito maior que {small} ({big} ≫ {small}).</span><span id=\"htGreaterSmallerMsgWrong\" class=\"htGreaterSmallerHidden\">Vamos relembrar: O número {small} é menor que o número {big}. ({small} < {big}).</span><span id=\"htGreaterSmallerMsgWrongMuch\" class=\"htGreaterSmallerHidden\">Vamos relembrar: O número {small} é muito menor que o número {big}. ({small} ≪ {big}).</span><span id=\"htGreaterSmallerMsgFinal\" class=\"htGreaterSmallerHidden\">🎉🎉🎉 Parabéns! Você completou todos os níveis! 🎉🎉🎉</span><span id=\"htGreaterSmallerPlayAgain\" class=\"htGreaterSmallerHidden\">Jogar novamente</span><span id=\"htGreaterSmallerNextLabel\" class=\"htGreaterSmallerHidden\">Próximo nível</span></div>",
