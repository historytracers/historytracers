      {
         "id": "chapter2_body",
         "target": "class-chapter2",
         "page": "class_content",
         "value_type": "group-list",
         "html_value": null,
         "source": null,
         "value": [
            {
               "family_id": "",
               "person_id": "",
               "id": "d803c26d-4643-4a92-bdf6-e40dbede3543",
               "name": "Inteiros",
               "desc": "Ainda não conhecemos todos os inteiros: neste texto, descobrimos os que vivem do outro lado do espelho, observando os reflexos em espelhos e na superfície da água.",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "2d8929a4-e2a4-42d9-8bb0-25da112f65c8",
               "name": "Iguais, mas diferentes",
               "desc": "No espelho vemos os mesmos números dos dois lados; muda apenas o sinal. Neste texto, começamos a fazer contas com números de sinais opostos e descobrimos que a subtração é uma soma.",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "bf35bb89-f566-4469-91b0-889cfc38e0d6",
               "name": "Modulando (Parte I)",
               "desc": "Neste texto, aprendemos que caminhar na direção oposta compartilha muitas regras com caminhar na direção que conhecemos, e fazemos operações do outro lado do zero com a ajuda de Copán e do caminho Peabirú.",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "d1d3730c-3d29-425b-b4bb-26697cc1fede",
               "name": "Exercitando a soma (números negativos)",
               "desc": "Um aplicativo que gera somas aleatórias de números negativos e descreve cada etapa do cálculo, para que você pratique até somar negativos sem dificuldade.",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "05f0f747-c4e2-4c34-8cc4-be7ee1d37edd",
               "name": "Modulando (Parte II)",
               "desc": "Neste texto, apresentamos a “tabuada negativa” — multiplicar por -1 — e como ela nos ajuda a entender o outro lado da reta numérica.",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "61ebf26a-c8ab-4bb4-bd1a-5bd2d5a5a28a",
               "name": "Modulando (Parte III)",
               "desc": "Continuando o texto anterior, usamos a “tabuada negativa” para aprofundar o entendimento das inclinações: caminhos que sobem e descem, como o Peabirú.",
               "date_time": null
            }
         ],
         "date_time": null
      },
