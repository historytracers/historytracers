         "html_value": null,
         "source": null,
         "value": [
            {
               "family_id": "",
               "person_id": "",
               "id": "a648cecf-238e-4294-a012-3830ff833d67",
               "name": "Desenhando a multiplicação",
               "desc": "Neste texto, aprendemos a receita para desenhar qualquer tabuada: escrever uma fórmula, marcar seus pontos e uni-los.",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "2acc8c3a-8b10-4b67-8d70-ec1113e691c4",
               "name": "Entendendo a Tabuada (0 e 1)",
               "desc": "Muitas vezes a tabuada é apresentada apenas como algo a ser memorizado — mas por que ignorar todo o conhecimento que vem junto com ela? Neste texto, descobrimos o que realmente significa multiplicar por 0 e por 1.",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "f7f4988d-1427-4e26-a6a8-c375c57924c7",
               "name": "Entendendo a Tabuada (2 e 3)",
               "desc": "Neste texto, exploramos a relação entre a tabuada e os triângulos enquanto estudamos as tabuadas do 2 e do 3.",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "ad9516ac-2893-4649-8d62-7f9cfe69cc64",
               "name": "Entendendo a Tabuada (4 e 5)",
               "desc": "Neste texto, exploramos a relação entre triângulos e montanhas enquanto estudamos as tabuadas do 4 e do 5.",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "a0afca38-89d0-4fda-a133-e26e092d19e0",
               "name": "Copiando a natureza",
               "desc": "Neste texto, exploramos como o conhecimento da multiplicação poderia ter ajudado os povos antigos — da menor casa até as grandes obras de Caral.",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "833029d7-d81e-477a-9008-102d52d61983",
               "name": "Entendendo a Tabuada (6 e 7)",
               "desc": "Neste texto, exploramos como os povos da Mesopotâmia usaram essas duas tabuadas, a base da forma como medimos o tempo hoje: sessenta segundos em cada minuto.",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "e730ab7c-ed0b-4b3c-8f57-3dea7965ff2e",
               "name": "Entendendo a Tabuada (8 e 9)",
               "desc": "O que aconteceria se saíssemos do plano da página? E se fôssemos mais fundo, para dentro das próprias figuras?",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "6535fc4d-c1f9-423f-963f-5ec705b3640b",
               "name": "Entendendo as tabuadas (Resumo)",
               "desc": "Após estudar as 10 tabuadas, revisamos todo o conteúdo — desta vez no caminho inverso: partimos dos gráficos e chegamos até a fórmula geral.",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "21f8d529-1c27-4f02-b880-81954daaf6ac",
               "name": "Multiplicando os achados com grupos",
               "desc": "Um jogo para praticar a tabuada: cada tabuada aparece como grupos de figuras iguais e cada resposta correta revela um achado arqueológico.",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "b9e71da5-355b-4c0c-8d24-a746a27fcc3e",
               "name": "Praticando a multiplicação por números de um dígito",
               "desc": "Um aplicativo que ensina a multiplicação por números de um dígito em três níveis e descreve cada passo do cálculo.",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "4f0474ba-3c05-43cd-8528-d3f383eae556",
               "name": "Multiplicando os achados",
               "desc": "Um jogo para praticar a tabuada: cada resposta correta revela um achado arqueológico.",
               "date_time": null
            }
         ],
         "date_time": null
