   "exercise_v2": [
      {
         "question": "Um quadrado tem quatro lados?",
         "yesNoAnswer": "Yes",
         "additionalInfo": "Sim. Um quadrado tem quatro lados iguais, e um retângulo também tem quatro lados."
      },
      {
         "question": "4 × 5 é igual a 20?",
         "yesNoAnswer": "Yes",
         "additionalInfo": "Quatro grupos de cinco são 5 + 5 + 5 + 5 = 20, então 4 × 5 = 20."
      },
      {
         "question": "Uma mão tem seis dedos?",
         "yesNoAnswer": "No",
         "additionalInfo": "Não. Uma mão tem cinco dedos, então 5 × 1 = 5."
      }
