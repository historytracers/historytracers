      {
         "id": "SECTION_print_parts",
         "text": [
            {
               "text": "<div class=\"htBoardPartsActions\"><p class=\"htBoardPrintBar\"><button type=\"button\" class=\"htBoardPrintButton\" onclick=\"htBoardPrintParts(); return false;\">Imprimir as peças do jogo (3 páginas)</button></p><p class=\"htBoardPartsNote\">A primeira página é o osso, a segunda página são as vinte marcas e a terceira página são os dois baralhos de cartas.</p></div>",
