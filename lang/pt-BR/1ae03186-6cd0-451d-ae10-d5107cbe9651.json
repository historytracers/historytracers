                        "day": "27"
                     }
                  }
               ],
               "date_time": [
                  {
                     "type": "gregory",
                     "year": "2018",
                     "month": "-1",
                     "day": "-1"
                  },
                  {
                     "type": "gregory",
                     "year": "1615",
                     "month": "-1",
                     "day": "-1"
                  }
               ],
               "isTable": false,
               "imgdesc": "",
               "format": "html",
               "PostMention": ""
            },
            {
               "text": "Quando usamos as setas à direita, vemos os dedos subirem um a um. Isso mostra os números de 0 a 9 em ordem. Os círculos na Yupana mostram os mesmos números",
               "source": [
                  {
                     "type": 0,
                     "uuid": "f5b74f18-0bc4-46d2-8a5c-64dd80b74dd1",
                     "text": "Poma de Ayala, Felipe Guaman",
                     "page": "pp. 361 - 362",
                     "date_time": {
                        "type": "gregory",
                        "year": "1615",
                        "month": "",
                        "day": ""
                     }
                  },
                  {
                     "type": 1,
                     "uuid": "a62b520a-f443-4d83-ab51-b99c9a46dab8",
                     "text": "Prem, Dhavit",
                     "page": "pp. 354 - 363",
                     "date_time": {
                        "type": "gregory",
                        "year": "2018",
                        "month": "",
                        "day": ""
                     }
                  },
                  {
                     "type": 1,
                     "uuid": "2d2ea4a5-506b-4dbf-aaa4-3a10a8fbbd9c",
                     "text": "Prem, Dhavit",
                     "page": "",
                     "date_time": {
                        "type": "gregory",
                        "year": "2018",
                        "month": "",
                        "day": ""
                     }
                  }
               ],
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "markdown",
               "PostMention": "."
            },
            {
               "text": "Mover os dedos para cima ao contar é mais do que apenas ordenar. É sobre avançar adicionando um. Cada vez que levantamos um dedo, vamos para o próximo número somando 1. Podemos mostrar isso com o símbolo \"+\":",
               "source": null,
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "markdown",
               "PostMention": ""
            },
            {
               "text": "<center><div class=\"first_steps_reflection_parent\" style=\"background-color: #FFFFFF;\"><div class=\"first_steps_reflection\" style=\"background-color: #FFFFFF;\"><p><math mathsize=\"1.5em\" displaystyle=\"false\"><mn>0</mn><mo lspace=\"0.1667em\" rspace=\"0.1667em\">+</mo><mn>1</mn><mo lspace=\"0.1667em\" rspace=\"0.1667em\">=</mo><mn>1</mn></math></p><p><math mathsize=\"1.5em\" displaystyle=\"false\"><mn>1</mn><mo lspace=\"0.1667em\" rspace=\"0.1667em\">+</mo><mn>1</mn><mo lspace=\"0.1667em\" rspace=\"0.1667em\">=</mo><mn>2</mn></math></p><p><math mathsize=\"1.5em\" displaystyle=\"false\"><mn>2</mn><mo lspace=\"0.1667em\" rspace=\"0.1667em\">+</mo><mn>1</mn><mo lspace=\"0.1667em\" rspace=\"0.1667em\">=</mo><mn>3</mn></math></p><p><math mathsize=\"1.5em\" displaystyle=\"false\"><mn>3</mn><mo lspace=\"0.1667em\" rspace=\"0.1667em\">+</mo><mn>1</mn><mo lspace=\"0.1667em\" rspace=\"0.1667em\">=</mo><mn>4</mn></math></p><p><math mathsize=\"1.5em\" displaystyle=\"false\"><mn>4</mn><mo lspace=\"0.1667em\" rspace=\"0.1667em\">+</mo><mn>1</mn><mo lspace=\"0.1667em\" rspace=\"0.1667em\">=</mo><mn>5</mn></math></p><p><math mathsize=\"1.5em\" displaystyle=\"false\"><mn>5</mn><mo lspace=\"0.1667em\" rspace=\"0.1667em\">+</mo><mn>1</mn><mo lspace=\"0.1667em\" rspace=\"0.1667em\">=</mo><mn>6</mn></math></p><p><math mathsize=\"1.5em\" displaystyle=\"false\"><mn>6</mn><mo lspace=\"0.1667em\" rspace=\"0.1667em\">+</mo><mn>1</mn><mo lspace=\"0.1667em\" rspace=\"0.1667em\">=</mo><mn>7</mn></math></p><p><math mathsize=\"1.5em\" displaystyle=\"false\"><mn>7</mn><mo lspace=\"0.1667em\" rspace=\"0.1667em\">+</mo><mn>1</mn><mo lspace=\"0.1667em\" rspace=\"0.1667em\">=</mo><mn>8</mn></math></p><p><math mathsize=\"1.5em\" displaystyle=\"false\"><mn>8</mn><mo lspace=\"0.1667em\" rspace=\"0.1667em\">+</mo><mn>1</mn><mo lspace=\"0.1667em\" rspace=\"0.1667em\">=</mo><mn>9</mn></math></p><p class=\"desc\"><b>Cálculo 1</b>: Contagem dos números através da adição de 1.</p></div></div></center>",
               "source": null,
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "html",
               "PostMention": ""
            }
         ]
      },
      {
         "id": "SECTION_rules",
         "text": [
            {
               "text": "### Um axioma da adição\n\nQuando estudamos as famílias numéricas, aprendemos que no sistema decimal contamos até o nove (9)—o maior dígito. Depois voltamos ao zero (0) e somamos um ao dígito à esquerda. Como a adição é uma forma de transitar entre os números, essa regra também funciona para a adição. Podemos mostrar isso usando o formato vertical:",
               "source": [
                  {
                     "type": 1,
                     "uuid": "00f3ab60-2017-420a-99dc-56de384243e8",
                     "text": "History Tracers Team",
                     "page": "Famílias numéricas (Parte I)",
                     "date_time": {
                        "type": "gregory",
                        "year": "2024",
                        "month": "",
                        "day": ""
                     }
                  },
                  {
                     "type": 1,
                     "uuid": "94c4d446-cc89-499b-8404-b528e5107864",
                     "text": "Weisstein, Eric W.",
                     "page": "",
                     "date_time": {
                        "type": "",
                        "year": "",
                        "month": "",
                        "day": ""
                     }
                  }
               ],
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "markdown",
               "PostMention": "."
            },
            {
               "text": "<p style=\"text-align=center\"><center>&nbsp;1&nbsp;&nbsp;<br />&nbsp;&nbsp;&nbsp;&nbsp;9<br />+&nbsp;&nbsp;&nbsp;1<br />____________<br />&nbsp;&nbsp;1 0</center></p><p class=\"desc\"><b>Cálculo 2</b>: Contagem dos números representada pela adição de 1 no formato vertical.</p>",
               "source": null,
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "html",
               "PostMention": ""
            },
            {
               "text": "Mas o Cálculo 2 está faltando alguns detalhes importantes. O número 1 no topo parece que apenas \"cai\" para o resultado. O zero (0), que significa vazio (<htcite0>), geralmente fica escondido à esquerda de um número. Mas podemos mostrá-lo. Vamos reescrever o Cálculo 2 (<htcite1>):",
               "source": [
                  {
                     "type": 1,
                     "uuid": "576e4648-77fa-4a6d-9e51-9459ced964f3",
                     "text": "Musa, Auwalu",
                     "page": "pp. 46 - 48",
                     "date_time": {
                        "type": "gregory",
                        "year": "2024",
                        "month": "",
                        "day": ""
                     }
                  },
                  {
                     "type": 1,
                     "uuid": "94c4d446-cc89-499b-8404-b528e5107864",
                     "text": "Weisstein, Eric W.",
                     "page": "",
                     "date_time": {
                        "type": "",
                        "year": "",
                        "month": "",
                        "day": ""
                     }
                  }
               ],
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "markdown",
               "PostMention": ""
            },
            {
