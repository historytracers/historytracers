         "smile": "thinking",
         "source_menu": [],
         "text": [
            {
               "text": "Vamos lembrar o que aprendemos.\n\nCom o que vimos até agora: um ponto conta como um objeto, e um retângulo conta como cinco objetos?",
               "source": [],
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "markdown/html/text",
               "PostMention": ""
            }
         ],
         "desc": null,
         "next": "15a8f64e-4fac-4f31-906c-95554cccb36a",
         "prev": "",
         "jumpTo": "",
         "answer": "yes",
         "score": 1
