                  "year": "2024",
                  "month": "",
                  "day": ""
               }
            },
            {
               "type": 1,
               "uuid": "00f3ab60-2017-420a-99dc-56de384243e8",
               "text": "Texto Original",
               "page": "index.html?page=class_content&arg=9d4c7f85-0e69-4795-a738-0acb54f2011d",
