         "audio": "",
         "smile": "thinking",
         "source_menu": [],
         "text": [
            {
               "text": "Além das mãos, poderíamos utilizar os pés para contar?",
               "source": [],
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "markdown",
               "PostMention": ""
            }
         ],
         "desc": null,
         "next": "a0dcf9c2-32df-4325-a0a0-8af2ffea381e",
         "prev": "",
         "jumpTo": "",
         "answer": "yes",
         "score": 2
      },
