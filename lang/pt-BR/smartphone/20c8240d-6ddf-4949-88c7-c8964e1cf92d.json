                  "type": "gregory",
                  "year": "2025",
                  "month": "",
                  "day": ""
               }
            }
         ],
         "text": [
            {
               "text": "Quando Sócrates fez esta afirmação, ele entendia que não podemos conhecer todas as coisas?",
               "source": [],
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "markdown",
               "PostMention": ""
            }
         ],
         "desc": null,
         "next": "7ca84a61-9912-4004-b07e-f44a19fbdaa4",
         "prev": "c69673be-0a59-4235-a83e-0f2d26e13ede",
         "jumpTo": "",
         "answer": "Yes",
         "score": 2
      },
      {
         "id": "7ca84a61-9912-4004-b07e-f44a19fbdaa4",
         "audio": "",
         "smile": "happy",
         "source_menu": [],
         "text": [
            {
               "text": "#### Motivação\n\nA conclusão de Sócrates, formulada há milênios, não deve ser motivo de desânimo. Ao contrário, deve servir de estímulo. À medida que aprendemos, descobrimos que há sempre mais a aprender.",
               "source": [],
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "markdown",
               "PostMention": ""
            }
         ],
         "desc": null,
