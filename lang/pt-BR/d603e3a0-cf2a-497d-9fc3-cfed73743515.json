   "exercise_v2": [
      {
         "question": "Os números mesoamericanos e os etrusco-romanos possuem exatamente o mesmo sistema de contagem?",
         "yesNoAnswer": "No",
         "additionalInfo": "Os números mesoamericanos possuem apenas 3 símbolos, enquanto os etrusco-romanos desenvolveram 7 símbolos. Além disso, os números não são representados da mesma maneira."
      },
      {
         "question": "É possível escrever números de diferentes maneiras?",
         "yesNoAnswer": "Yes",
         "additionalInfo": "Apesar de existir uma padronização associada ao alfabeto, os números podem ser escritos de diferentes maneiras, de acordo com a forma de escrita de cada pessoa ou povo."
      }
   ],
