               "PostMention": ""
            },
            {
               "text": "### Pré-requisitos\n\nRecomendamos que o leitor revise o texto anterior e seus pré-requisitos antes de prosseguir",
               "source": [
                  {
                     "type": 1,
                     "uuid": "b6428e19-afcf-4d3b-916d-46e5a332ef53",
                     "text": "History Tracers Team",
                     "page": "Entendendo a tabuada (0 e 1)",
                     "date_time": {
                        "type": "gregory",
                        "year": "2025",
                        "month": "-1",
                        "day": "-1"
                     }
                  }
               ],
               "date_time": null,
               "isTable": false,
