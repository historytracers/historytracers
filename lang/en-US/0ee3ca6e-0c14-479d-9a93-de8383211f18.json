      {
         "id": "SECTION_print_parts",
         "text": [
            {
               "text": "<div class=\"htBoardPartsActions\"><p class=\"htBoardPrintBar\"><button type=\"button\" class=\"htBoardPrintButton\" onclick=\"htBoardPrintParts(); return false;\">Print the game parts (3 pages)</button></p><p class=\"htBoardPartsNote\">The first page is the bone, the second page is the twenty marks and the third page is the two card decks.</p></div>",
