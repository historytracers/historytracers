   "content": [
      {
         "id": "SECTION_prerequisites",
         "text": [
            {
               "text": "<p><span id=\"htZoomImageMsg\"></span></p>",
               "source": null,
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "html",
               "PostMention": ""
            },
            {
               "text": "<p><h3>Prerequisites</h3>The game on this page aims to reinforce the order of the numbers from 0 to 99. Before starting, we suggest studying the following previous pages:</p><p><ul><li><htcite0>: we learn that our body has two equal sides.</li> <li><htcite1>: we learn how to count using our body.</li> <li><htcite2>: we see the limits of counting with our body and why we need new tools.</li> <li><htcite3>: we learn the order of numbers as generations of a family.</li></ul></p>",
               "source": [
                  {
                     "type": 1,
                     "uuid": "20b14681-88c0-438a-a273-a0902ae5db38",
                     "text": "History Tracers Team",
                     "page": "Our sides are equal",
                     "date_time": {
                        "type": "gregory",
                        "year": "2023",
                        "month": "05",
                        "day": "30"
                     }
                  },
                  {
                     "type": 1,
                     "uuid": "3874d1e8-0f76-4432-9ee2-d8c8c9dccf53",
                     "text": "History Tracers Team",
                     "page": "Counting",
                     "date_time": {
                        "type": "gregory",
                        "year": "2024",
                        "month": "06",
                        "day": "12"
                     }
                  },
                  {
                     "type": 1,
                     "uuid": "cc8c1467-a6af-4f9c-ba60-ab6df35aba05",
