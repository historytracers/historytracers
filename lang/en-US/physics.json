         "value": [
            {
               "family_id": "",
               "person_id": "",
               "id": "964083ad-c587-43dc-9649-5b578714ab44",
               "name": "Returning",
               "desc": "In this text, we present the subtraction operation as a form of return.",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "d10a36f0-bb91-4d66-b3de-6158b71b0ce2",
               "name": "Cooking",
               "desc": "The preparation of food is often remembered for adding quantities, but there is also another side to it.",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "4736db57-6444-4631-b3c8-08e4d1e35688",
               "name": "Practicing subtraction",
               "desc": "In this text, the reader is introduced to an application that generates random subtraction problems with descriptions of the calculation steps.",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "ad77fd20-9769-4c5b-9e0c-266f6001bc2b",
               "name": "The Difference of Equals",
               "desc": "In this text, we study the mathematical operation that allows us to determine whether something is equal or not.",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "34a60cba-30a4-4ffa-9eba-87d79e10636f",
               "name": "Nearly identical",
               "desc": "As atoms were generated in nature, some of them ended up so similar that we cannot tell them apart.",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "e1f0eeb1-c74b-4e7e-97dd-90f592fab221",
               "name": "There is something else",
               "desc": "In this text, we divide portions in the kitchen, discovering that there is something else beyond adding quantities.",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "9e2e82c6-804c-4541-80b4-7df337d32764",
               "name": "Divisions and remainders",
               "desc": "In this text, the reader is introduced to an application that generates random divisions with descriptions of the calculation steps.",
               "date_time": null
            },
            {
