         "html_value": null,
         "source": null,
         "value": [
            {
               "family_id": "",
               "person_id": "",
               "id": "7cc05340-732f-4c3d-b260-5437670fbc99",
               "name": "Shared Origin",
               "desc": "In this text, we take a journey back in time to understand what current measurements reveal about the universe’s past.",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "cfd6324b-8f37-4390-a540-b575facee8d7",
               "name": "Everything Was Together",
               "desc": "In this text, we follow the history of the universe, from the Big Bang to the present day, and reflect on our common origin.",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "58da6d75-ce8a-45f5-b57f-1f0763ee3568",
               "name": "Simplicity vs. Complexity",
               "desc": "Despite more than 13.8 billion years of evolution of the universe, we often still wish to be like it was in its beginnings. Why?",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "9b0e87f9-e372-49d4-979e-4ba9742f70e1",
               "name": "Two sides",
               "desc": "good vs. evil, left vs. right, matter vs. energy, up vs. down. Is this duality enough?",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "5dee0038-d6c8-404e-8039-5b9a2d11e115",
               "name": "Odd or even?",
               "desc": "In this text, we use the remainder of division by 2 to introduce even and odd numbers.",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "8dfdd5e0-01e3-4ebc-b0c2-38462a54aa98",
               "name": "Odd or even? (Game)",
               "desc": "A game to practice identifying odd and even numbers by sharing circles into pairs.",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "c137d968-eb5a-47e7-90b1-1c4cadd47ca9",
               "name": "Expanding...",
               "desc": "Continuing from the previous text, we see that dividing into just two sides ends up doing omissions",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "a9086b63-70d4-4984-a353-1118305128b6",
               "name": "Always present",
               "desc": "many times we are so focused on ourselves or on opposites that we do not notice what is always present.",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "81397cf9-5675-40e0-aead-a01bee8b7fe8",
               "name": "Evolution of Knowledge: The Atom",
               "desc": "In this text, we study how our idea of the atom has evolved over time.",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "71ecd258-95b4-4ee8-98c9-3627a70d6a09",
               "name": "The four divisions",
               "desc": "in addition to the four limbs of the human body, the number four has also been used in various contexts throughout the history of humanity.",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "645d488c-b9cd-4365-ac22-8ef85a50c304",
               "name": "Dividing again",
               "desc": "When we perform a division, we can repeat it — but how can we represent this idea in the language of mathematics?",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "06ba77b4-6841-4b2c-9512-ab9762df6e0d",
               "name": "Evolution of knowledge – The hydrogen atom",
               "desc": "Hydrogen is the smallest atom we know of; even so, inside it we can still find other particles.",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "ebb5e822-8c85-41ee-92b0-6b6b82adf573",
               "name": "Is this extra?",
               "desc": "In this text, we present the rules to know whether a number is divisible by 1, 2, 3 or 4.",
               "date_time": null
            }
         ],
         "date_time": null
      },
