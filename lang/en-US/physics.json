            {
               "family_id": "",
               "person_id": "",
               "id": "1ae03186-6cd0-451d-ae10-d5107cbe9651",
               "name": "Walking Among the Numbers",
               "desc": "In this text, we explore the relationships between integers.",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "48f8f1cd-5036-4140-aafc-697963fe5dfb",
               "name": "Exercising with numbers",
               "desc": "We do a physical exercise with the numbers to reinforce the addition of units and tens.",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "8fe2026a-08b0-4297-b480-cb76d11dfa0f",
               "name": "The Order of Addition",
               "desc": "In this text, we explore the Commutative Axiom of Addition, learning that the order of numbers does not change the result.",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "462b1750-2d39-454d-a780-f22d4bd154c3",
               "name": "Practicing the Axioms of Addition",
               "desc": "An interactive game to reinforce the addition identity (a + 0 = a) and the commutative axiom (a + b = b + a).",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "687a38b5-de0e-4d16-a4d0-8ec87a545ccb",
               "name": "Running Among the Numbers",
               "desc": "In this text, we learn how to add large numbers, drawing an analogy to Mesoamerican reconstructions.",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "cabc9843-35ef-4e4f-92fd-17eda864b55e",
               "name": "Advancing an Order and the Complement",
               "desc": "We learn when a sum leaves its order and how the complement marks the limit right before that happens.",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "5539096c-dd7d-4f9c-a137-f0465725b9f4",
               "name": "Carry or Not Carry? (Game)",
               "desc": "A game to decide whether a column carries 1 to the next order, using the complement to 10, across units, tens, hundreds and thousands.",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "411fc48b-20aa-4514-9fc8-152a6eb9e263",
               "name": "Does addition always give the same result?",
               "desc": "Adding numbers can't always be compared to walking. In this text, we'll explore addition of numbers in more detail.",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "a4caa9fe-de1e-49c5-92de-50ed9c22a42d",
               "name": "Practicing addition",
               "desc": "In this text, the reader is introduced to an application that generates random additions with step-by-step descriptions of the calculation.",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "e2f50f78-05d9-44d6-abb6-77dbe7a56794",
               "name": "The result is",
               "desc": "a game of consecutive sums that helps uncover the story.",
               "date_time": null
            }
         ],
         "date_time": null
