            {
               "family_id": "",
               "person_id": "",
               "id": "d862242c-0538-4b18-8b32-4a84d4a5858e",
               "name": "Adding the same numbers",
               "desc": "Some math operations repeat themselves—what’s so special about that?",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "71a07afa-964d-4e43-93c1-b2e0ed330acb",
               "name": "The result is (Phase II)",
               "desc": "a game to reinforce the connection between addition and multiplication.",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "ae53cf73-8e7d-4a2c-80a3-1cb79b7c48bc",
               "name": "Inversion",
               "desc": "In life, some experiences yield entirely different outcomes depending on the path we take. Does the same apply to multiplication?",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "a648cecf-238e-4294-a012-3830ff833d67",
               "name": "Drawing the multiplication",
               "desc": "In this text, we learn the recipe to draw any multiplication table: create a formula, plot its points, and connect them.",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "a0afca38-89d0-4fda-a133-e26e092d19e0",
               "name": "Learning from nature",
               "desc": "This text explores how knowledge of multiplication could have helped ancient civilizations.",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "4f0474ba-3c05-43cd-8528-d3f383eae556",
               "name": "Multiplying the Findings",
               "desc": "A game to practice the multiplication tables, revealing archaeological findings with each correct answer.",
               "date_time": null
            }
         ],
         "date_time": null
      },
