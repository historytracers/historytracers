      {
         "id": "SECTION_prerequisites",
         "text": [
            {
               "text": "<p><span id=\"htZoomImageMsg\"></span></p><p class=\"topdesc\"><span id=\"htAmericaAbyaYalaMsg\"></span> (<htcite0>).</p>",
               "source": [
                  {
                     "type": 1,
                     "uuid": "160fb48c-1711-491e-a1aa-e1257e7889af",
                     "text": "Porto-Gonçalves, Carlos Walter",
                     "page": "pp. 39-43",
                     "date_time": {
                        "type": "gregory",
