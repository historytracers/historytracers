ke=\"black\" /> <line x1=\"273\" y1=\"274\" x2=\"84\" y2=\"80\" stroke=\"black\" /> <line x1=\"295\" y1=\"254\" x2=\"126\" y2=\"80\" stroke=\"black\" /> <line x1=\"164\" y1=\"119\" x2=\"197\" y2=\"80\" stroke=\"black\" /> <line x1=\"164\" y1=\"119\" x2=\"164\" y2=\"80\" stroke=\"black\" /> <line x1=\"295\" y1=\"254\" x2=\"242\" y2=\"80\" stroke=\"black\" /> <line x1=\"295\" y1=\"254\" x2=\"282\" y2=\"80\" stroke=\"black\" /> <line x1=\"397\" y1=\"156\" x2=\"326\" y2=\"80\" stroke=\"black\" /> <line x1=\"397\" y1=\"156\" x2=\"366\" y2=\"80\" stroke=\"black\" /> <line x1=\"397\" y1=\"156\" x2=\"404\" y2=\"80\" stroke=\"black\" /> <line x1=\"397\" y1=\"156\" x2=\"444\" y2=\"80\" stroke=\"black\" /></svg></div></p><p class=\"desc\"><b>Figure 4</b>: Relationship between humans and closely related species.</p>",
