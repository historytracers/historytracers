=\"1.5\"/><text x=\"122.5\" y=\"67\" font-size=\"16\" fill=\"#0d47a1\">1</text><text x=\"187.5\" y=\"67\" font-size=\"16\" fill=\"#0d47a1\">2</text><text x=\"252.5\" y=\"67\" font-size=\"16\" fill=\"#0d47a1\">3</text><text x=\"317.5\" y=\"67\" font-size=\"16\" fill=\"#0d47a1\">4</text><text x=\"382.5\" y=\"67\" font-size=\"16\" fill=\"#0d47a1\">5</text><text x=\"447.5\" y=\"67\" font-size=\"16\" fill=\"#0d47a1\">6</text><text x=\"512.5\" y=\"67\" font-size=\"16\" fill=\"#0d47a1\">7</text><text x=\"122.5\" y=\"109\" font-size=\"16\" fill=\"#0d47a1\">8</text><text x=\"187.5\" y=\"109\" font-size=\"16\" fill=\"#0d47a1\">9</text><text x=\"252.5\" y=\"109\" font-size=\"16\" fill=\"#0d47a1\">10</text><text x=\"317.5\" y=\"109\" font-size=\"16\" fill=\"#0d47a1\">11</text><text x=\"382.5\" y=\"109\" font-size=\"16\" fill=\"#0d47a1\">12</text><text x=\"447.5\" y=\"109\" font-size=\"16\" fill=\"#0d47a1\">13</text><text x=\"512.5\" y=\"109\" font-size=\"16\" fill=\"#0d47a1\">14</text><text x=\"122.5\" y=\"151\" font-size=\"16\" fill=\"#0d47a1\">15</text><text x=\"187.5\" y=\"151\" font-size=\"16\" fill=\"#0d47a1\">16</text><text x=\"252.5\" y=\"151\" font-size=\"16\" fill=\"#0d47a1\">17</text><text x=\"317.5\" y=\"151\" font-size=\"16\" fill=\"#0d47a1\">18</text><text x=\"382.5\" y=\"151\" font-size=\"16\" fill=\"#0d47a1\">19</text><text x=\"447.5\" y=\"151\" font-size=\"16\" fill=\"#0d47a1\">20</text><text x=\"512.5\" y=\"151\" font-size=\"16\" fill=\"#0d47a1\">21</text><text x=\"122.5\" y=\"193\" font-size=\"16\" fill=\"#0d47a1\">22</text><text x=\"187.5\" y=\"193\" font-size=\"16\" fill=\"#0d47a1\">23</text><text x=\"252.5\" y=\"193\" font-size=\"16\" fill=\"#0d47a1\">24</text><text x=\"317.5\" y=\"193\" font-size=\"16\" fill=\"#0d47a1\">25</text><text x=\"382.5\" y=\"193\" font-size=\"16\" fill=\"#0d47a1\">26</text><text x=\"447.5\" y=\"193\" font-size=\"16\" fill=\"#0d47a1\">27</text><text x=\"512.5\" y=\"193\" font-size=\"16\" fill=\"#0d47a1\">28</text><text x=\"80\" y=\"67\" font-size=\"14\" font-weight=\"bold\" fill=\"#0d47a1\" text-anchor=\"end\">Week 1</text><text x=\"80\" y=\"109\" font-size=\"14\" font-weight=\"bold\" fill=\"#0d47a1\" text-anchor=\"end\">Week 2</text><text x=\"80\" y=\"151\" font-size=\"14\" font-weight=\"bold\" fill=\"#0d47a1\" text-anchor=\"end\">Week 3</text><text x=\"80\" y=\"193\" font-size=\"14\" font-weight=\"bold\" fill=\"#0d47a1\" text-anchor=\"end\">Week 4</text></g></svg></p><p class=\"desc\"><b>Figure 4</b>: A calendar with four weeks, from day 1 to day 28.</p>",
