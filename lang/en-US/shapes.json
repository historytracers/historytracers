            {
               "family_id": "",
               "person_id": "",
               "id": "950c054a-6290-41b4-bbac-7b3fd87f809b",
               "name": "The History of a Theorem",
               "desc": "The story of how we discovered that the sum of the squares of the legs equals the square of the hypotenuse.",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "4f5cb70e-d246-49b2-ae2a-9841ffc1fb14",
               "name": "Practicing with the theorem",
               "desc": "In this text, we use the Babylonian Diagonal Triple (Pythagorean Theorem) to reinforce our mathematical knowledge.",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "26a09f5e-c28b-42ef-8fcc-885ccd4a60e7",
               "name": "Playing with the Theorem",
               "desc": "In this text, we explore the Babylonian diagonal triple (Pythagorean Theorem) through an application that facilitates its visualization.",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "5f39ac75-9dd9-4dbc-b57f-65857c9a65fa",
               "name": "The Theorem and the Circle",
               "desc": "The relationship of multiplication tables with angles and the circle.",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "8fccfdf4-8c44-4513-983f-d9713489519d",
               "name": "Trigonometry (Cosine)",
               "desc": "We define the cosine of an angle.",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "dc29a98c-70c2-49b3-b3a7-431b040dbfed",
               "name": "Trigonometry (Sine)",
               "desc": "We define the sine of an angle.",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "931557c0-ca2b-4b50-b034-1ed53752c58e",
               "name": "Where are we on a disk?",
               "desc": "We explain how we use sine and cosine to locate ourselves on a circle.",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "47db4900-f8b8-48ce-90d6-def1961e7f1a",
               "name": "Walking on the Circle",
               "desc": "We derive the relationship cos² (θ) + sin² (θ) = 1.",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "0c501a6b-4f55-451d-b206-f2748231edf9",
               "name": "Playing with the Identity",
               "desc": "We explore the relationship sin² (θ) + cos² (θ) = 1.",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "11a45836-9276-445c-8416-370cf816188c",
               "name": "Do we tangent the planet?",
               "desc": "We learn about the tangent function.",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "93bcd356-bb92-4390-b78d-fff12bfd0374",
               "name": "Playing with the Tangent",
               "desc": "We explore the relationship 1 + tan² (θ) = sec² (θ).",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "f74e0412-ac03-4bc4-b6a1-fa22dd5c441d",
               "name": "Playing with the Cotangent",
               "desc": "We explore the relationship 1 + cot² (θ) = csc² (θ).",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "25108a0e-7670-4cac-bc1c-5db63138ab09",
               "name": "Our Position",
               "desc": "We visualize the tangent on a circle.",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "520b1f8f-4ac5-453a-9856-98b54b3e2822",
               "name": "The other hypotenuse",
               "desc": "We study the cosecant of an angle.",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "4e1d9713-7c3a-4f26-8cf6-2a72c239646e",
               "name": "The other opposite side",
               "desc": "We study the cosecant of an angle.",
               "date_time": null
            },
            {
               "family_id": "",
               "person_id": "",
               "id": "9ebb8f7c-7728-4e2b-a179-c077c913e4f2",
               "name": "Functions and Trigonometric Relationships",
               "desc": "We choose between functions and trigonometric relationships and iterate with the triangle, the circle and the charts.",
               "date_time": null
            }
         ],
