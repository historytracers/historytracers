         ]
      }
   ],
   "exercise_v2": [
      {
         "question": "Does a square have four sides?",
         "yesNoAnswer": "Yes",
         "additionalInfo": "Yes. A square has four equal sides, and a rectangle also has four sides."
      },
      {
         "question": "Is 4 × 5 equal to 20?",
         "yesNoAnswer": "Yes",
         "additionalInfo": "Four groups of five are 5 + 5 + 5 + 5 = 20, so 4 × 5 = 20."
      },
      {
         "question": "Does one hand have six fingers?",
         "yesNoAnswer": "No",
         "additionalInfo": "No. One hand has five fingers, so 5 × 1 = 5."
      }
   ],
