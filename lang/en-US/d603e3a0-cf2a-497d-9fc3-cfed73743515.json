            }
         ]
      }
   ],
   "exercise_v2": [
      {
         "question": "Do Mesoamerican and Etruscan-Roman numbers have exactly the same counting system?",
         "yesNoAnswer": "No",
         "additionalInfo": "Mesoamerican numbers have only 3 symbols, while Etruscan-Roman numbers developed 7 symbols. Additionally, the numbers are not represented in the same way."
      },
      {
         "question": "Is it possible to write numbers in different ways?",
         "yesNoAnswer": "Yes",
         "additionalInfo": "Although there is a standardization associated with the alphabet, numbers can be written in different ways, according to the writing style of each person or people."
      }
   ],
