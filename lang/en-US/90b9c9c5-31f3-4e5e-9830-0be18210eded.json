            },
            {
               "text": "<p><div class=\"htChart\"><canvas aria-label=\"chart\" id=\"chart1\" style=\"width:30em !important; height:20em !important;\"></canvas></p><p class=\"desc\"><b>Chart 1</b>: Symbols in the First Verse (11 letters + 1 colon = 12). Chart created with the <htcite0> library.</div></p>",
               "source": [
                  {
