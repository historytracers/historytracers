         "answer": null,
         "score": 1
      },
      {
         "id": "2f0348fc-2f99-400a-82d9-5570c447f3e7",
         "audio": "",
         "smile": "thinking",
         "source_menu": [],
         "text": [
            {
               "text": "Besides our hands, could we use our feet to count?",
               "source": [],
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "markdown",
               "PostMention": ""
            }
         ],
         "desc": null,
         "next": "a0dcf9c2-32df-4325-a0a0-8af2ffea381e",
         "prev": "",
         "jumpTo": "",
         "answer": "yes",
         "score": 2
      },
