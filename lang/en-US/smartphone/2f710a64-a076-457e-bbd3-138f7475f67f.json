               }
            }
         ],
         "text": [
            {
                "text": "#### Rectangles\n\nNow, put all your fingers together. We could represent these fingers as if they were a rectangle.",
               "source": [],
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "markdown/html/text",
               "PostMention": ""
            },
            {
               "text": "<style>.rectangle { width: 300px; height: 150px; background-color: #51ff00; }</style><div class=\"rectangle\"></div>",
