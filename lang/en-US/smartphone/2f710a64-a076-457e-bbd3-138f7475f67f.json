         "smile": "thinking",
         "source_menu": [],
         "text": [
            {
               "text": "Let's remember what we learned.\n\nWith what we saw so far: does a dot count as one object, and does a rectangle count as five objects?",
               "source": [],
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "markdown/html/text",
               "PostMention": ""
            }
         ],
         "desc": null,
         "next": "15a8f64e-4fac-4f31-906c-95554cccb36a",
         "prev": "",
         "jumpTo": "",
         "answer": "yes",
         "score": 1
      },
      {
