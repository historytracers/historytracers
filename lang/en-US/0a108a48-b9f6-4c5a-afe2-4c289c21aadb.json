            {
               "text": "<p class=\"desc\"><img id=\"imgGeo6\" onclick=\"htImageZoom('imgGeo6', '0%')\" src=\"\" class=\"imgcenter\"/><b>Figure 1</b>: This map highlights Africa in the world © Mapswire (<htcite0>)</p>",
               "source": [
                  {
                     "type": 1,
                     "uuid": "10cd855b-c2dc-4045-8a6c-f8486ef67cfa",
                     "text": "Mapswire",
                     "page": "",
                     "date_time": {
                        "type": "gregory",
