      {
         "id": "SECTION_humanspecies",
         "text": [
            {
               "text": "<p><h3>Human Species</h3>The time of existence of human species is a period that ranges from thousands of years up to a few million years.</p><p>This time was determined by different excavations that found skeletons that survived over time, such as bones of <i>Homo ergaster</i>, a species that lived almost 2 million years ago (<htcite0> ; <htcite1>).</p>",
               "source": [
                  {
                     "type": 1,
                     "uuid": "816d0d03-bd90-4bcd-84ef-a2316dc68eff",
                     "text": "Hitchcock, Don",
                     "page": "Homo erectus - Homo ergaster",
                     "date_time": {
                        "type": "gregory",
                        "year": "2013",
                        "month": "",
                        "day": ""
                     }
                  },
                  {
                     "type": 1,
                     "uuid": "ab1dda1e-95c2-4087-8299-e851e58bdc6f",
                     "text": "History Tracers Team",
                     "page": "Humans",
                     "date_time": {
                        "type": "gregory",
                        "year": "2026",
                        "month": "-1",
                        "day": "-1"
                     }
                  }
               ],
               "date_time": null,
