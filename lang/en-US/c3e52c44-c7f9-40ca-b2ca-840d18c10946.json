   "content": [
      {
         "id": "SECTION_prerequisites",
         "text": [
            {
               "text": "<p><span id=\"htZoomImageMsg\"></span></p>",
               "source": null,
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "html",
               "PostMention": ""
            },
            {
               "text": "<p><h3>Prerequisites</h3>This game helps you practice the Etruscan-Roman numeral system, also known as the Latin numeral system. Before you start, we suggest reviewing the previous lessons about their origin (<htcite0>), about how to write numbers from 1 to 10 (<htcite1>), and about how to write large numbers (<htcite2>).</p>",
               "source": [
                  {
                     "type": 1,
                     "uuid": "886ccce8-3be8-4aba-bc86-94864e96b355",
                     "text": "History Tracers Team",
                     "page": "Text or number?",
                     "date_time": {
                        "type": "gregory",
                        "year": "2026",
                        "month": "",
                        "day": ""
                     }
                  },
                  {
                     "type": 1,
                     "uuid": "5fc193f7-7226-4852-82d1-706a44de71ec",
                     "text": "History Tracers Team",
                     "page": "And the missing numbers?",
                     "date_time": {
                        "type": "gregory",
                        "year": "2026",
                        "month": "",
                        "day": ""
                     }
                  },
                  {
                     "type": 1,
                     "uuid": "b9cf2c23-7f0f-4e73-9ba2-2b53c7b60f05",
                     "text": "History Tracers Team",
                     "page": "Large Etruscan-Roman numbers",
                     "date_time": {
                        "type": "gregory",
                        "year": "2026",
                        "month": "",
                        "day": ""
                     }
                  }
               ],
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "html",
               "PostMention": ""
